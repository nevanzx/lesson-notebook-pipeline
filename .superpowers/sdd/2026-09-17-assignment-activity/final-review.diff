+        wm.innerHTML = "";
+        for (var i = 0; i < 14; i++)
+          wm.appendChild(LN.h("span", { text: t,
+            style: "left:" + (8 + (i % 4) * 22) + "%;top:" +
+              (6 + Math.floor(i / 4) * 15) + "%" }));
+      }
+      idIn.addEventListener("input", function () {
+        idIn.value = idIn.value.replace(/\D/g, "").slice(0, 8);
+        syncWM();
+      });
