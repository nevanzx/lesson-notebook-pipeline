+def sanitize_assignment_data(data_text, key, data):
+    """Rewrite LN.data.<key> in the student output without any answer material."""
+    m = re.search(r"LN\.data\." + re.escape(key) + r"\s*=\s*", data_text)
+    if not m:
+        return data_text
+    i = data_text.index("{", m.end())
